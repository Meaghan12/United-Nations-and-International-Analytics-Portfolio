# OpenAI API Key (required if DEMO_MODE=false)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model selection (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Demo mode: set to true to use pre-computed responses without an API key
# Recommended for GitHub portfolio demonstrations
DEMO_MODE=true
